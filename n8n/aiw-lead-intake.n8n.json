        "jsCode": "const b = $input.first().json.body || {};\nconst c = (v) => String(v ?? '').trim().slice(0, 1000);\nconst lead = {\n  Timestamp: new Date().toISOString(),\n  Name: c(b.name),\n  Phone: c(b.phone),\n  Email: c(b.email).toLowerCase(),\n  Service: c(b.service),\n  'Budget (USD)': c(b.budget),\n  Market: c(b.market),\n  Location: c(b.location),\n  Project: c(b.project),\n  Consent: c(b.consent),\n  Source: c(b.source) || 'direct',\n  Status: 'New'\n};\nif (!lead.Name || !/^\\S+@\\S+\\.\\S+$/.test(lead.Email) || lead.Consent !== 'Yes') {\n  throw new Error('Invalid submission');\n}\nreturn [{ json: lead }];"
